{
  "name": "iobroker.fusionsolar",
  "version": "1.3.1",
  "description": "Adapter to connect Huawei FusionSolar API",
  "author": {
    "name": "KornSW",
    "email": "email@kornsw.de"
  },
  "contributors": [
    {
      "name": "Stolly82"
    },
    {
      "name": "vr6syncro"
    }
  ],
  "homepage": "https://github.com/KornSW/ioBroker.fusionsolar",
  "license": "MIT",
  "keywords": [
    "Huawei",
    "FusionSolar",
    "SUN2000",
    "PV",
    "ioBroker"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/KornSW/ioBroker.fusionsolar.git"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@iobroker/adapter-core": "^3.4.3",
    "axios": "^1.20.0"
  },
  "devDependencies": {
    "@iobroker/adapter-dev": "^1.5.0",
    "@iobroker/dev-server": "^0.8.0",
    "@iobroker/eslint-config": "^2.3.4",
    "@iobroker/testing": "^6.3.0",
    "@iobroker/types": "^7.2.3",
    "@tsconfig/node22": "^22.0.6",
    "@types/node": "^22.20.2",
    "typescript": "~6.0.3"
  },
  "main": "main.js",
  "files": [
    "admin{,/!(src)/**}/!(tsconfig|tsconfig.*|.eslintrc).{json,json5}",
    "admin{,/!(src)/**}/*.{html,css,png,svg,jpg,js}",
    "lib/",
    "!lib/**/*.test.js",
    "io-package.json",
    "LICENSE",
    "main.js"
  ],
  "scripts": {
    "test:js": "mocha --config test/mocharc.custom.json \"{!(node_modules|test)/**/*.test.js,*.test.js,test/**/test!(PackageFiles|Startup).js}\"",
    "test:package": "mocha test/package --exit",
    "test:integration": "mocha test/integration --exit",
    "test": "npm run test:js && npm run test:package",
    "check": "tsc --noEmit -p tsconfig.check.json",
    "lint": "eslint -c eslint.config.mjs .",
    "translate": "translate-adapter",
    "test:kvu": "python -m unittest discover -s .kvu -p \"test_*.py\""
  },
  "bugs": {
    "url": "https://github.com/KornSW/ioBroker.fusionsolar/issues"
  },
  "readmeFilename": "README.md"
}
